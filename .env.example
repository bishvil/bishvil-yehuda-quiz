# Bishvil Yehuda Quiz — local environment template.
# Real values live in .env.local (git-ignored). Do NOT add secrets here.
# Policy and rationale: see docs/dev-tooling.md §4.3–§4.5.

# === Public (browser-exposed) ===
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<redacted-local-anon-jwt>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Server-only ===
# Local Supabase defaults only. Replace in .env.local after linking a cloud project.
SUPABASE_SERVICE_ROLE_KEY=<redacted-local-service-role-jwt>
SUPABASE_PROJECT_REF=local

# Drizzle / Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# App
APP_ENV=dev
APP_LOG_LEVEL=info

# Cron / scheduled work (filled in once cron routes are added)
CRON_SECRET=
